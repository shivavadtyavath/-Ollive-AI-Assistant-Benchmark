# ============================================================
# ENVIRONMENT VARIABLES - Copy this to .env and fill in values
# ============================================================

# --- Frontier Model: Groq (FREE at console.groq.com) ---
GROQ_API_KEY=your_groq_api_key_here

# --- OSS Model: HuggingFace Inference API (FREE at huggingface.co) ---
HF_API_TOKEN=your_hf_token_here

# --- Observability: LangSmith (FREE at smith.langchain.com) ---
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ollive-ai-assistants

# --- App Config ---
OSS_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
FRONTIER_MODEL_ID=llama-3.3-70b-versatile
MAX_HISTORY_TURNS=10
